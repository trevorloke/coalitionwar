# ── Site ────────────────────────────────────────────────────────────────
# Public URL of the site, used for Stripe redirect URLs and unsubscribe links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL: Neon, Supabase, RDS, Render, or local) ───────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/imagine_surrey

# ── Stripe ──────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use sk_test_… until you go live.
STRIPE_SECRET_KEY=sk_test_replace_me
# Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Contributions (BC Local Elections Campaign Financing Act) ──────────
# Annual limit per contributor, per slate, in cents. 2026: $1,429.70.
CONTRIBUTION_LIMIT_CENTS=142970
# Yearly membership fee in cents. Membership fees count as contributions.
# Set to 0 for free membership (no Stripe checkout).
MEMBERSHIP_FEE_CENTS=1000

# ── Admin dashboard (/admin) ───────────────────────────────────────────
# A long random password, and a separate long random secret for signing the session cookie.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
